  ],
  "name": [ { "use": "official", "family": "Fort", "given": ["Ricardo", "Aníbal"] } ],
  "gender": "male",
  "_gender": {
    "extension": [
      {
        "url": "https://bus.msal.gob.ar",
        "valueCodeableConcept": {
          "coding": [ { "system": "http://hl7.org.ar", "code": "1", "display": "Varón" } ]
        }
      }
    ]
  },
  "birthDate": "1968-11-05",
  "maritalStatus": { "coding": [ { "system": "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus", "code": "M", "display": "Married" } ] },
  "telecom": [
