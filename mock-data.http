    { "system": "email", "value": "marty.mcfly@kinesiologia-domiciliaria.local", "use": "work" }
  ],
  "address": [
    {
      "use": "work",
      "line": ["Av. Olascoaga 1234"],
      "city": "Neuquén",
      "state": "Neuquén",
      "postalCode": "8300",
      "country": "AR"
    }
  ],
  "gender": "male",
  "birthDate": "1985-03-22",
